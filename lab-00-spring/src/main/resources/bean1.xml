    <!--2 set方法注入属性-->
    <bean id="book" class="com.janson.lab00.spring.model.Book">
        <!--使用property标签设置属性值
            name类里面属性名称
            value向属性注入的值
        -->
        <property name="bname" value="易筋经"></property>
        <property name="bauthor" value="达摩老祖"></property>
        <!--null值-->
        <!--        <property name="address">
                    <null/>
                </property>-->
        <!--属性值包含特殊符号
        1、把<>进行转义 &lt; &gt;
        2、使用CDATA标签包裹属性值
        -->
        <property name="address">
            <!--<value><![CDATA[<<南京>>]]></value>-->
            <value>"&lt;&lt;南京&gt;&gt;"</value>
        </property>
    </bean>

